# Team Orchestrator local-server example environment.
# Copy to server.env, edit values, then run:
# docker compose --env-file server.env -f docker-compose.server.yml up --build -d

# Bind published ports to loopback by default. Use 0.0.0.0 only for a trusted LAN.
ATHENA_SERVER_BIND_ADDRESS=127.0.0.1
ATHENA_SERVER_API_PORT=8787
ATHENA_SERVER_CONSOLE_PORT=5173

# Required for the server compose profile. Use a long random value.
ATHENA_AUTH_API_TOKEN=replace-with-a-long-random-api-token
ATHENA_CONSOLE_PASSWORD=replace-with-a-console-password

# Host-owned durable paths. Use absolute paths on a real server.
ATHENA_SERVER_WORKSPACE_PATH=/srv/team-orchestrator/workspace
ATHENA_SERVER_STATE_PATH=/srv/team-orchestrator/state
ATHENA_SERVER_ARTIFACTS_PATH=/srv/team-orchestrator/artifacts
ATHENA_SERVER_REPOS_PATH=/srv/team-orchestrator/repos
ATHENA_SERVER_PLUGINS_PATH=/srv/team-orchestrator/plugins
ATHENA_SERVER_SECRETS_PATH=/srv/team-orchestrator/secrets

# Docker-backed sandbox support. On Linux this is usually /var/run/docker.sock.
ATHENA_SERVER_DOCKER_SOCKET=/var/run/docker.sock
ATHENA_SANDBOX_WORKSPACE_HOST_PATH=/srv/team-orchestrator/workspace

# Optional model provider environment secrets. Prefer configuring provider secrets in the console
# as local-file references under /run/secrets/athena when possible.
# ATHENA_OPENAI_API_KEY=
# ATHENA_FOUNDRY_API_KEY=
