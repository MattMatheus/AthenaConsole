# Team Orchestrator environment reference.
#
# Copy to server.env, edit values, then run:
# docker compose --env-file server.env -f docker-compose.server.yml up --build -d
#
# This file documents every ATHENA_* variable read by
# packages/core/src/shared/config.ts, plus compose-only ATHENA_SERVER_* helpers.
# Optional examples are commented out. Uncomment only the settings you need.
#
# Security-relevant settings:
# - ATHENA_AUTH_ENABLED enables bearer/header auth. Default: false.
# - ATHENA_AUTH_API_TOKEN is required when auth is enabled; use a long random value.
# - ATHENA_AUTHZ_MODE controls authorization enforcement. Default: off.
# - ATHENA_ALLOW_EXTERNAL_UNAUTHENTICATED should stay false for exposed servers.
# - ATHENA_ALLOWED_ORIGINS defaults to *; set explicit console/proxy origins for exposed servers.
# - ATHENA_AUTH_TRUSTED_PROXY_CONFIGURED should be true only after a reverse proxy strips inbound
#   x-athena-identity and injects authenticated identities. See:
#   docs/developer/product-dev-guides/trusted-proxy-auth.md

###############################################################################
# Compose server helpers
###############################################################################

# Bind published ports to loopback by default. Use 0.0.0.0 only for a trusted LAN.
ATHENA_SERVER_BIND_ADDRESS=127.0.0.1
ATHENA_SERVER_API_PORT=8787
ATHENA_SERVER_CONSOLE_PORT=5173

# Required by the server compose profile. Replace these locally before boot.
ATHENA_AUTH_API_TOKEN=__set_a_long_random_api_token__
ATHENA_CONSOLE_PASSWORD=__set_a_console_password__

# Host-owned durable paths. Use absolute paths on a real server.
ATHENA_SERVER_WORKSPACE_PATH=/srv/team-orchestrator/workspace
ATHENA_SERVER_STATE_PATH=/srv/team-orchestrator/state
ATHENA_SERVER_ARTIFACTS_PATH=/srv/team-orchestrator/artifacts
ATHENA_SERVER_REPOS_PATH=/srv/team-orchestrator/repos
ATHENA_SERVER_PLUGINS_PATH=/srv/team-orchestrator/plugins
ATHENA_SERVER_SECRETS_PATH=/srv/team-orchestrator/secrets

# Docker-backed sandbox support. On Linux this is usually /var/run/docker.sock.
ATHENA_SERVER_DOCKER_SOCKET=/var/run/docker.sock

# AthenaAgent is packaged into the API image from the sibling ../AthenaAgent
# build context. These container paths normally do not need local shell setup.
ATHENA_AGENT_REPO=/opt/athena-agent-src
ATHENA_AGENT_PYTHON=/opt/athena-agent-venv/bin/python

###############################################################################
# Paths and local runtime defaults
###############################################################################

# ATHENA_WORKSPACE_ROOT: workspace root for repo, .env, and relative state resolution.
# Optional. Default: process cwd passed to loadConfig.
# ATHENA_WORKSPACE_ROOT=/srv/team-orchestrator/workspace

# ATHENA_STATE_DIR: app-state directory, relative to workspace root unless absolute.
# Optional. Default: .athena.
# ATHENA_STATE_DIR=.athena

# ATHENA_EXECUTION_PROVIDER_DEFAULT: default task execution backend.
# Optional. Allowed: local-placeholder, docker, k8s. Default: local-placeholder.
# ATHENA_EXECUTION_PROVIDER_DEFAULT=local-placeholder

# ATHENA_SANDBOX_BACKEND_PROVIDER: legacy alias used as fallback for ATHENA_EXECUTION_PROVIDER_DEFAULT.
# Optional. Allowed: local-placeholder, docker, k8s.
# ATHENA_SANDBOX_BACKEND_PROVIDER=docker

# ATHENA_LOCK_PROVIDER_DEFAULT: default lock provider.
# Optional. Allowed: local, redis, k8s-lease. Default: local.
# ATHENA_LOCK_PROVIDER_DEFAULT=local

# ATHENA_DISTRIBUTED_LOCK_PROVIDER: enables optional distributed lock/metrics provider selection.
# Optional. Allowed: local, redis, k8s-lease. Also used as fallback for ATHENA_LOCK_PROVIDER_DEFAULT.
# ATHENA_DISTRIBUTED_LOCK_PROVIDER=redis

# ATHENA_REDIS_URL: Redis URL for redis-backed locking.
# Optional. Default: unset.
# ATHENA_REDIS_URL=redis://localhost:6379

###############################################################################
# Auth, authz, CORS, and trusted proxy
###############################################################################

# ATHENA_AUTH_ENABLED: enable API auth.
# Optional. Boolean. Default: false.
# ATHENA_AUTH_ENABLED=true

# ATHENA_AUTH_API_TOKEN: bearer token for API auth. Required when auth is enabled.
# Optional when auth is disabled. Minimum length: 16 when set. Default: unset.
# ATHENA_AUTH_API_TOKEN=__set_a_long_random_api_token__

# ATHENA_AUTH_IDENTITY_HEADER: trusted identity header name.
# Optional. Lowercase letters, numbers, and dashes only. Default: x-athena-identity.
# ATHENA_AUTH_IDENTITY_HEADER=x-athena-identity

# ATHENA_AUTH_TRUSTED_PROXY_CONFIGURED: declares that an external proxy strips inbound identity headers.
# Optional. Strict boolean. Default: false.
ATHENA_AUTH_TRUSTED_PROXY_CONFIGURED=false

# ATHENA_AUTH_DEFAULT_ROLE: default RBAC role for identities not mapped explicitly.
# Optional. Allowed: Viewer, Operator, Admin. Default: Viewer.
# ATHENA_AUTH_DEFAULT_ROLE=Viewer

# ATHENA_AUTH_IDENTITY_ROLE_MAP: comma-separated identity:role mappings.
# Optional. Roles: Viewer, Operator, Admin. Example format only; set real identities locally.
# ATHENA_AUTH_IDENTITY_ROLE_MAP=console:Admin,operator:Operator,healthcheck:Viewer,*:Viewer

# ATHENA_ALLOW_EXTERNAL_UNAUTHENTICATED: allow unauthenticated external access.
# Optional. Strict boolean. Default: false.
# ATHENA_ALLOW_EXTERNAL_UNAUTHENTICATED=false

# ATHENA_AUTHZ_MODE: authorization policy mode.
# Optional. Allowed: off, observe, soft-enforce, enforce. Default: off.
# ATHENA_AUTHZ_MODE=off

# ATHENA_AUTHZ_DEFAULT_DECISION: default authz decision when policy has no match.
# Optional. Allowed: allow, deny. Default: allow.
# ATHENA_AUTHZ_DEFAULT_DECISION=allow

# ATHENA_ALLOWED_ORIGINS: comma-separated allowed CORS origins.
# Optional. Default: *.
# ATHENA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

###############################################################################
# Model providers
###############################################################################

# ATHENA_DEFAULT_PROVIDER: default provider id.
# Optional. Default: mock.
# ATHENA_DEFAULT_PROVIDER=mock

# ATHENA_DEFAULT_MODEL: default model id.
# Optional. Default: mock-model.
# ATHENA_DEFAULT_MODEL=mock-model

# ATHENA_PROVIDER_FALLBACK_ORDER: comma-separated provider fallback order.
# Optional. Default: empty.
# ATHENA_PROVIDER_FALLBACK_ORDER=

# ATHENA_OPENAI_BASE_URL: OpenAI-compatible API base URL.
# Optional. Default: https://api.openai.com/v1.
# ATHENA_OPENAI_BASE_URL=https://api.openai.com/v1

# ATHENA_OPENAI_API_KEY: OpenAI-compatible API key.
# Optional. Prefer provider secrets in the console or local-file references.
# ATHENA_OPENAI_API_KEY=

# ATHENA_HTTP_PROVIDER_URL: generic HTTP provider endpoint.
# Optional. Default: unset.
# ATHENA_HTTP_PROVIDER_URL=

# ATHENA_HTTP_PROVIDER_API_KEY: generic HTTP provider API key.
# Optional. Default: unset.
# ATHENA_HTTP_PROVIDER_API_KEY=

# ATHENA_HTTP_PROVIDER_TIMEOUT_MS: generic HTTP provider timeout.
# Optional. Positive integer milliseconds. Default: 20000.
# ATHENA_HTTP_PROVIDER_TIMEOUT_MS=20000

# ATHENA_FOUNDRY_ENABLED: enable Azure AI Foundry provider config.
# Optional. Boolean. Default: false.
# ATHENA_FOUNDRY_ENABLED=false

# ATHENA_FOUNDRY_PROJECT_ENDPOINT: Azure AI Foundry project endpoint.
# Optional. Default: unset.
# ATHENA_FOUNDRY_PROJECT_ENDPOINT=

# ATHENA_FOUNDRY_DEPLOYMENT: Azure AI Foundry deployment name.
# Optional. Default: unset.
# ATHENA_FOUNDRY_DEPLOYMENT=

# ATHENA_FOUNDRY_API_VERSION: Azure AI Foundry API version.
# Optional. Default: 2024-05-01-preview.
# ATHENA_FOUNDRY_API_VERSION=2024-05-01-preview

# ATHENA_FOUNDRY_USE_ENTRA_ID: use Entra ID instead of API key for Foundry.
# Optional. Boolean. Default: false.
# ATHENA_FOUNDRY_USE_ENTRA_ID=false

# ATHENA_FOUNDRY_AUDIENCE: Entra ID audience for Foundry.
# Optional. Default: https://cognitiveservices.azure.com/.default.
# ATHENA_FOUNDRY_AUDIENCE=https://cognitiveservices.azure.com/.default

# ATHENA_FOUNDRY_MANAGED_IDENTITY_CLIENT_ID: managed identity client id for Foundry.
# Optional. Default: unset.
# ATHENA_FOUNDRY_MANAGED_IDENTITY_CLIENT_ID=

# ATHENA_FOUNDRY_API_KEY: Azure AI Foundry API key.
# Optional. Prefer secret references when possible.
# ATHENA_FOUNDRY_API_KEY=

###############################################################################
# Azure auth, Key Vault, and billing
###############################################################################

# ATHENA_AZURE_AUTH_ENABLED: enable Azure auth helpers.
# Optional. Boolean. Default: false.
# ATHENA_AZURE_AUTH_ENABLED=false

# ATHENA_AZURE_OPENAI_USE_ENTRA_ID: use Entra ID for Azure OpenAI.
# Optional. Boolean. Default: false.
# ATHENA_AZURE_OPENAI_USE_ENTRA_ID=false

# ATHENA_AZURE_OPENAI_AUDIENCE: Azure OpenAI token audience.
# Optional. Default: https://cognitiveservices.azure.com/.default.
# ATHENA_AZURE_OPENAI_AUDIENCE=https://cognitiveservices.azure.com/.default

# ATHENA_AZURE_MANAGED_IDENTITY_CLIENT_ID: managed identity client id.
# Optional. Default: unset.
# ATHENA_AZURE_MANAGED_IDENTITY_CLIENT_ID=

# ATHENA_AZURE_KEY_VAULT_URL: Key Vault URL for provider secret lookup.
# Optional. Default: unset.
# ATHENA_AZURE_KEY_VAULT_URL=

# ATHENA_AZURE_OPENAI_KEY_SECRET_NAME: Key Vault secret name for Azure OpenAI key.
# Optional. Default: unset.
# ATHENA_AZURE_OPENAI_KEY_SECRET_NAME=

# ATHENA_AZURE_BILLING_ENABLED: enable Azure billing cost collection.
# Optional. Boolean. Default: false.
# ATHENA_AZURE_BILLING_ENABLED=false

# ATHENA_AZURE_BILLING_AUDIENCE: Azure billing token audience.
# Optional. Default: https://management.azure.com/.default.
# ATHENA_AZURE_BILLING_AUDIENCE=https://management.azure.com/.default

# ATHENA_AZURE_BILLING_SCOPE_RESOURCE_ID: Azure billing scope resource id.
# Optional. Default: unset.
# ATHENA_AZURE_BILLING_SCOPE_RESOURCE_ID=

# ATHENA_AZURE_BILLING_SUBSCRIPTION_ID: Azure billing subscription id.
# Optional. Default: unset.
# ATHENA_AZURE_BILLING_SUBSCRIPTION_ID=

# ATHENA_AZURE_BILLING_RESOURCE_GROUP_NAME: Azure billing resource group.
# Optional. Default: unset.
# ATHENA_AZURE_BILLING_RESOURCE_GROUP_NAME=

# ATHENA_AZURE_BILLING_API_VERSION: Azure billing API version.
# Optional. Default: 2023-03-01.
# ATHENA_AZURE_BILLING_API_VERSION=2023-03-01

###############################################################################
# Durable memory and local memory
###############################################################################

# ATHENA_MEMORY_ENABLED: enable local memory features.
# Optional. Boolean. Default: false.
# ATHENA_MEMORY_ENABLED=false

# ATHENA_MEMORY_SQLITE_PATH: SQLite path for local memory.
# Optional. Default: unset.
# ATHENA_MEMORY_SQLITE_PATH=

# ATHENA_MEMORY_INCLUDE_TRANSCRIPTS: include transcripts in local memory.
# Optional. Boolean. Default: false.
# ATHENA_MEMORY_INCLUDE_TRANSCRIPTS=false

# ATHENA_MEMORY_MAX_RESULTS: max memory search results.
# Optional. Positive integer. Default: 6.
# ATHENA_MEMORY_MAX_RESULTS=6

# ATHENA_MEMORY_MAX_SNIPPET_CHARS: max chars per memory snippet.
# Optional. Positive integer. Default: 700.
# ATHENA_MEMORY_MAX_SNIPPET_CHARS=700

# ATHENA_MEMORY_MAX_INJECTED_CHARS: max memory chars injected into context.
# Optional. Positive integer. Default: 2500.
# ATHENA_MEMORY_MAX_INJECTED_CHARS=2500

# ATHENA_DURABLE_MEMORY_MODE: durable memory backend mode.
# Optional. Allowed: disabled, local-dev, server-mode, remote-http. Default: disabled.
# ATHENA_DURABLE_MEMORY_MODE=disabled

# ATHENA_DURABLE_MEMORY_PROVIDER_ID: durable memory provider id.
# Optional. Default: durable-memory.
# ATHENA_DURABLE_MEMORY_PROVIDER_ID=durable-memory

# ATHENA_DURABLE_MEMORY_PROVIDER_LABEL: operator-visible durable memory label.
# Optional. Default: Durable memory.
# ATHENA_DURABLE_MEMORY_PROVIDER_LABEL=Durable memory

# ATHENA_DURABLE_MEMORY_REMOTE_URL: remote durable memory base URL.
# Optional. Takes precedence over ATHENA_DURABLE_MEMORY_BASE_URL. Default: unset.
# ATHENA_DURABLE_MEMORY_REMOTE_URL=

# ATHENA_DURABLE_MEMORY_BASE_URL: legacy/alternate remote durable memory base URL.
# Optional. Used when ATHENA_DURABLE_MEMORY_REMOTE_URL is unset. Default: unset.
# ATHENA_DURABLE_MEMORY_BASE_URL=

# ATHENA_DURABLE_MEMORY_TOKEN_ENV: environment variable name containing remote memory token.
# Optional. Mutually exclusive with ATHENA_DURABLE_MEMORY_TOKEN_FILE. Default: unset.
# ATHENA_DURABLE_MEMORY_TOKEN_ENV=

# ATHENA_DURABLE_MEMORY_TOKEN_FILE: absolute local file containing remote memory token.
# Optional. Mutually exclusive with ATHENA_DURABLE_MEMORY_TOKEN_ENV. Default: unset.
# ATHENA_DURABLE_MEMORY_TOKEN_FILE=

# ATHENA_DURABLE_MEMORY_CACHE_MODE: durable memory cache mode.
# Optional. Allowed: disabled, read-through, read-through-write-queue. Default: disabled.
# ATHENA_DURABLE_MEMORY_CACHE_MODE=disabled

# ATHENA_DURABLE_MEMORY_LOCAL_DEV_ONLY: mark durable memory provider as local-dev only.
# Optional. Boolean. Default: true for disabled/local-dev modes, otherwise false.
# ATHENA_DURABLE_MEMORY_LOCAL_DEV_ONLY=false

# ATHENA_DURABLE_MEMORY_TIMEOUT_MS: durable memory provider timeout.
# Optional. Positive integer milliseconds. Default: 15000.
# ATHENA_DURABLE_MEMORY_TIMEOUT_MS=15000

# ATHENA_DURABLE_MEMORY_OPERATOR_STATUS: operator-visible durable memory status override.
# Optional. Allowed: remote-current, remote-unavailable, cache-current, cache-stale,
# queued-intent, conflict-review-required, local-dev-only, diagnostic-only. Default: diagnostic-only.
# ATHENA_DURABLE_MEMORY_OPERATOR_STATUS=diagnostic-only

###############################################################################
# Runtime isolation and sandbox
###############################################################################

# ATHENA_SANDBOX_ENABLED: enable sandbox integration.
# Optional. Boolean. Default: false.
# ATHENA_SANDBOX_ENABLED=false

# ATHENA_SANDBOX_REQUIRE_FOR_HIGH_SECURITY: require sandbox for high-security profile.
# Optional. Boolean. Default: false.
# ATHENA_SANDBOX_REQUIRE_FOR_HIGH_SECURITY=false

# ATHENA_SANDBOX_WORKSPACE_HOST_PATH: absolute host workspace path for sandbox mounts.
# Optional. Must be absolute when set. Default: unset.
# ATHENA_SANDBOX_WORKSPACE_HOST_PATH=/srv/team-orchestrator/workspace

# ATHENA_RUNTIME_ISOLATION_DEFAULT_PROFILE: default runtime isolation profile.
# Optional. Allowed: standard, high-security. Default: standard.
# ATHENA_RUNTIME_ISOLATION_DEFAULT_PROFILE=standard

# ATHENA_RUNTIME_ISOLATION_FALLBACK_TO_DEFAULT_RUNTIME_CLASS: allow fallback to default runtime class.
# Optional. Strict boolean. Default: true.
# ATHENA_RUNTIME_ISOLATION_FALLBACK_TO_DEFAULT_RUNTIME_CLASS=true

# ATHENA_RUNTIME_ISOLATION_STANDARD_RUNTIME_CLASS: Kubernetes RuntimeClass for standard profile.
# Optional. Must be valid RuntimeClass name when set. Default: unset.
# ATHENA_RUNTIME_ISOLATION_STANDARD_RUNTIME_CLASS=

# ATHENA_RUNTIME_ISOLATION_STANDARD_REQUIRE_SANDBOX: require sandbox for standard profile.
# Optional. Strict boolean. Default: false.
# ATHENA_RUNTIME_ISOLATION_STANDARD_REQUIRE_SANDBOX=false

# ATHENA_RUNTIME_ISOLATION_HIGH_SECURITY_RUNTIME_CLASS: Kubernetes RuntimeClass for high-security profile.
# Optional. Must be valid RuntimeClass name when set. Default: unset.
# ATHENA_RUNTIME_ISOLATION_HIGH_SECURITY_RUNTIME_CLASS=

# ATHENA_RUNTIME_ISOLATION_HIGH_SECURITY_REQUIRE_SANDBOX: require sandbox for high-security profile.
# Optional. Strict boolean. Default: ATHENA_SANDBOX_REQUIRE_FOR_HIGH_SECURITY or false.
# ATHENA_RUNTIME_ISOLATION_HIGH_SECURITY_REQUIRE_SANDBOX=false

###############################################################################
# Runtime, scheduling, CLI, and operations
###############################################################################

# ATHENA_RUNTIME_RUN_TIMEOUT_MS: default runtime run timeout.
# Optional. Positive integer milliseconds. Default: 30000.
# ATHENA_RUNTIME_RUN_TIMEOUT_MS=30000

# ATHENA_SCHEDULE_RUN_TIMEOUT_MS: default scheduled run timeout.
# Optional. Positive integer milliseconds. Default: 45000.
# ATHENA_SCHEDULE_RUN_TIMEOUT_MS=45000

# ATHENA_RUN_HISTORY_RETENTION_DAYS: run history retention window.
# Optional. Positive integer days. Default: 30.
# ATHENA_RUN_HISTORY_RETENTION_DAYS=30

# ATHENA_RUN_HISTORY_RETENTION_SWEEP_MS: run history sweep interval.
# Optional. Positive integer milliseconds. Default: 3600000.
# ATHENA_RUN_HISTORY_RETENTION_SWEEP_MS=3600000

# ATHENA_CLI_TRANSPORT: CLI transport mode.
# Optional. Allowed: local, api, auto. Default: auto.
# ATHENA_CLI_TRANSPORT=auto

# ATHENA_API_BASE_URL: API base URL used by CLI/API transport.
# Optional. Default: unset.
# ATHENA_API_BASE_URL=http://127.0.0.1:8787

# ATHENA_CLI_API_TIMEOUT_MS: CLI API timeout.
# Optional. Positive integer milliseconds. Default: 5000.
# ATHENA_CLI_API_TIMEOUT_MS=5000

# ATHENA_OPERATIONS_METRICS_PROVIDER: operations metrics provider.
# Optional. Allowed: local, k8s. Default: unset.
# ATHENA_OPERATIONS_METRICS_PROVIDER=local

###############################################################################
# History and context management
###############################################################################

# ATHENA_HISTORY_MAX_ENTRIES: max transcript history entries.
# Optional. Positive integer. Default: 200.
# ATHENA_HISTORY_MAX_ENTRIES=200

# ATHENA_HISTORY_MAX_ENTRY_CHARS: max chars per history entry.
# Optional. Positive integer. Default: 8000.
# ATHENA_HISTORY_MAX_ENTRY_CHARS=8000

# ATHENA_HISTORY_REPAIR_TOOL_PAIRING: repair missing tool-call/tool-result pairs.
# Optional. Boolean. Default: true.
# ATHENA_HISTORY_REPAIR_TOOL_PAIRING=true

# ATHENA_HISTORY_STRIP_CONTROL_CHARS: strip control chars from history.
# Optional. Boolean. Default: true.
# ATHENA_HISTORY_STRIP_CONTROL_CHARS=true

# ATHENA_CONTEXT_STRATEGY: context compaction strategy.
# Optional. Allowed: raw, summary, distill, symbolic-signatures. Default: raw.
# ATHENA_CONTEXT_STRATEGY=raw

# ATHENA_CONTEXT_MAX_CHARS: max prompt context chars.
# Optional. Positive integer. Default: 32000.
# ATHENA_CONTEXT_MAX_CHARS=32000

# ATHENA_CONTEXT_RESERVE_CHARS: reserved chars for new turn output/overhead.
# Optional. Positive integer. Default: 2000.
# ATHENA_CONTEXT_RESERVE_CHARS=2000

# ATHENA_CONTEXT_MAX_OVERFLOW_RETRIES: max context overflow recovery attempts.
# Optional. Positive integer. Default: 2.
# ATHENA_CONTEXT_MAX_OVERFLOW_RETRIES=2

# ATHENA_CONTEXT_SUMMARY_MAX_CHARS: max summary chars for summary/distill strategies.
# Optional. Positive integer. Default: 2400.
# ATHENA_CONTEXT_SUMMARY_MAX_CHARS=2400

# ATHENA_CONTEXT_MAX_TOOL_RESULT_CHARS: max chars retained per tool result.
# Optional. Positive integer. Default: 12000.
# ATHENA_CONTEXT_MAX_TOOL_RESULT_CHARS=12000

###############################################################################
# Plugins and local command provider
###############################################################################

# ATHENA_PLUGIN_PATHS: comma-separated plugin search paths.
# Optional. Default: sample-plugins,.athena/plugins.
# ATHENA_PLUGIN_PATHS=sample-plugins,.athena/plugins

# ATHENA_SYSTEM_PLUGIN_PATHS: comma-separated system plugin paths.
# Optional. Default: bundled-plugins.
# ATHENA_SYSTEM_PLUGIN_PATHS=bundled-plugins

# ATHENA_LOCAL_PROVIDER_CMD: local placeholder provider command.
# Optional. Default: /bin/echo.
# ATHENA_LOCAL_PROVIDER_CMD=/bin/echo

# ATHENA_LOCAL_PROVIDER_ARGS: comma-separated local placeholder provider args.
# Optional. Default: empty.
# ATHENA_LOCAL_PROVIDER_ARGS=

###############################################################################
# Events, telemetry, and Application Insights
###############################################################################

# ATHENA_EVENTS_MAX_RECORDS: max local event records.
# Optional. Positive integer. Default: 10000.
# ATHENA_EVENTS_MAX_RECORDS=10000

# ATHENA_EVENTS_MAX_AGE_MS: max local event age.
# Optional. Positive integer milliseconds. Default: 2592000000.
# ATHENA_EVENTS_MAX_AGE_MS=2592000000

# ATHENA_EVENT_RETENTION_DAYS: alternate event retention setting in days.
# Optional. Positive integer days. Overrides ATHENA_EVENTS_MAX_AGE_MS when set. Default: 30.
# ATHENA_EVENT_RETENTION_DAYS=30

# ATHENA_EVENTS_MAX_BYTES: max local event store bytes.
# Optional. Positive integer. Default: 5000000.
# ATHENA_EVENTS_MAX_BYTES=5000000

# ATHENA_EVENT_MAX_BYTES: alternate event max bytes setting.
# Optional. Positive integer. Takes precedence over ATHENA_EVENTS_MAX_BYTES. Default: 5000000.
# ATHENA_EVENT_MAX_BYTES=5000000

# ATHENA_EVENT_SINK_JSONL_PATH: optional external redacted event JSONL sink.
# Optional. Default: unset.
# ATHENA_EVENT_SINK_JSONL_PATH=/srv/team-orchestrator/events/external-events.jsonl

# ATHENA_EVENT_SINK_INCLUDE_TYPES: comma-separated event types to export to sink.
# Optional. Empty exports all sink-supported events. Default: empty.
# ATHENA_EVENT_SINK_INCLUDE_TYPES=run.completed,safety.violation,evidence-bundle.exported,governance.audit.exported

# Application Insights telemetry is optional and the SDK is not installed by default.
# To enable it, set the connection string and install the SDK in the deployment:
# npm install applicationinsights
# If the package is absent, telemetry is silently disabled and the app runs normally.
#
# ATHENA_APPINSIGHTS_ENABLED: enable Application Insights telemetry.
# Optional. Boolean. Default: true when connection string is set, otherwise false.
# ATHENA_APPINSIGHTS_ENABLED=false

# ATHENA_APPINSIGHTS_CONNECTION_STRING: Application Insights connection string.
# Optional. Default: unset.
# ATHENA_APPINSIGHTS_CONNECTION_STRING=

# ATHENA_APPINSIGHTS_SAMPLING_PERCENTAGE: Application Insights sampling percentage.
# Optional. Positive integer. Default: 20.
# ATHENA_APPINSIGHTS_SAMPLING_PERCENTAGE=20

# ATHENA_APPINSIGHTS_CLOUD_ROLE_NAME: Application Insights cloud role name.
# Optional. Default: athena-control-plane.
# ATHENA_APPINSIGHTS_CLOUD_ROLE_NAME=athena-control-plane

# ATHENA_APPINSIGHTS_TRACK_DEPENDENCIES: track Application Insights dependencies.
# Optional. Boolean. Default: true.
# ATHENA_APPINSIGHTS_TRACK_DEPENDENCIES=true
