{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repo Summary Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["path"],
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute or plugin-relative path to the local repository to summarize."
    }
  }
}
