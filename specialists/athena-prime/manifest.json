{
  "schemaVersion": 1,
  "id": "athena-prime",
  "description": "Base Athena engineering persona that executes backlog stories end-to-end with governed, typed, test-backed delivery.",
  "context": {
    "promptFiles": ["prompt.md"],
    "skillFiles": ["skills.md"],
    "docFiles": ["docs.md", "SOUL.md", "PRINCIPLES.md"],
    "workspaceDocFiles": [
      "planning/prompts/active/next-agent-seed-prompt.md",
      "planning/backlog/active/README.md"
    ],
    "maxFileChars": 20000,
    "maxTotalChars": 120000
  },
  "skills": [
    {
      "id": "code-analysis",
      "tags": ["engineering", "delivery", "orchestration"]
    }
  ],
  "git": {
    "baseRefDefault": "main",
    "requireCleanWorktree": true,
    "baseRefAutodetect": true
  },
  "review": {
    "scope": "implementation",
    "inspectAddedDependencies": true,
    "rubric": {
      "correctness": true,
      "security": true,
      "performance": true,
      "maintainability": true,
      "testGaps": true,
      "storyExecution": true,
      "acceptanceCriteria": true,
      "handoffReadiness": true
    },
    "maxReferencedFiles": 16,
    "maxReferencedFileChars": 12000,
    "includeGlobs": ["**/*"],
    "excludeGlobs": ["**/dist/**", "**/build/**", "**/.next/**", "**/coverage/**", "**/vendor/**"]
  },
  "output": {
    "defaultFormat": "both",
    "writeJsonFile": true,
    "writeMarkdownFile": true,
    "stdoutDefault": "summary",
    "findingPriority": ["P1", "P2", "P3"],
    "confidenceRange": [0, 1]
  }
}
