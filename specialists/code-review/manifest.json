{
  "schemaVersion": 1,
  "id": "code-review",
  "description": "Reviews a git branch against a base branch and emits findings with priority/confidence. Suggestions only; does not apply changes.",
  "context": {
    "promptFiles": ["prompt.md"],
    "skillFiles": ["skills.md"],
    "docFiles": ["docs.md"],
    "maxFileChars": 20000,
    "maxTotalChars": 120000
  },
  "skills": [
    {
      "id": "code-analysis",
      "tags": ["navigation", "review"]
    }
  ],
  "git": {
    "baseRefDefault": "main",
    "requireCleanWorktree": true,
    "baseRefAutodetect": true
  },
  "review": {
    "scope": "diff",
    "inspectAddedDependencies": true,
    "rubric": {
      "correctness": true,
      "security": true,
      "performance": true,
      "maintainability": true,
      "testGaps": true
    },
    "maxReferencedFiles": 16,
    "maxReferencedFileChars": 12000,
    "includeGlobs": ["**/*"],
    "excludeGlobs": ["**/dist/**", "**/build/**", "**/.next/**", "**/coverage/**", "**/vendor/**"]
  },
  "output": {
    "defaultFormat": "both",
    "writeJsonFile": true,
    "writeMarkdownFile": true,
    "stdoutDefault": "summary",
    "findingPriority": ["P1", "P2", "P3"],
    "confidenceRange": [0, 1]
  }
}
