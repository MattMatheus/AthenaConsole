{
  "name": "team-orchestrator-workspace",
  "packageManager": "npm@11.9.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "athena": "node packages/core/dist/src/cli/main.js",
    "smoke:product": "node scripts/product-readiness-smoke.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:env": "node scripts/check-env-reference.mjs"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  }
}
