{
  "name": "@athena/core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Team Orchestrator core logic",
  "bin": {
    "athena": "dist/src/cli/main.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./api/*": "./dist/src/api/*.js",
    "./shared/*": "./dist/src/shared/*.js",
    "./control-plane/*": "./dist/src/control-plane/*.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/dev-system-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:schemas": "node scripts/generate-api-component-schemas.mjs",
    "check:schemas": "node scripts/generate-api-component-schemas.mjs --check",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "validate:manifests": "tsx scripts/validate-manifest-examples.ts",
    "validate:pack-fixtures": "tsx scripts/validate-pack-fixtures.ts",
    "athena": "node dist/src/cli/main.js",
    "test:runtime-isolation-benchmark:smoke": "vitest run tests/runtime-isolation.benchmark-smoke.test.ts"
  },
  "devDependencies": {
    "@athena/pdk": "*",
    "@eslint/js": "^9.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.1",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@azure/identity": "^4.6.0",
    "@kubernetes/client-node": "^1.4.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.10.0",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.1"
  }
}
