{
  "name": "@athena/core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "ProjectAthena core logic",
  "bin": {
    "athena": "dist/src/cli/main.js"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./api/*": "./dist/src/api/*.js",
    "./shared/*": "./dist/src/shared/*.js",
    "./control-plane/*": "./dist/src/control-plane/*.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node scripts/dev-system-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:schemas": "node scripts/generate-api-component-schemas.mjs",
    "check:schemas": "node scripts/generate-api-component-schemas.mjs --check",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "athena": "node dist/src/cli/main.js",
    "test:runtime-isolation-benchmark:smoke": "vitest run tests/runtime-isolation.benchmark-smoke.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "@athena/pdk": "*"
  },
  "dependencies": {
    "applicationinsights": "^3.12.0",
    "@azure/identity": "^4.6.0",
    "@kubernetes/client-node": "^1.4.0",
    "ioredis": "^5.4.1"
  }
}
