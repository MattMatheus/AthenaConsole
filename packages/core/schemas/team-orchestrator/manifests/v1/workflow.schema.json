{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://team-orchestrator.local/schemas/manifests/v1/workflow.schema.json",
  "title": "Team Orchestrator Workflow Template Manifest",
  "description": "Schema for *.workflow.yaml files authored by Team Orchestrator plugin packages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflow"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "goal", "tasks"],
      "properties": {
        "id": {
          "$ref": "#/definitions/namespacedId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/definitions/semver"
        },
        "description": {
          "type": "string"
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "context": true,
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/workflowInput"
          }
        },
        "providerRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/modelProviderRequirement"
          },
          "uniqueItems": true
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/taskTemplate"
          },
          "minItems": 1
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "icon": {
              "type": "string"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  },
  "definitions": {
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "workflowInput": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "markdown", "integer", "number", "boolean", "file", "json", "object", "array"]
        },
        "label": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": true
      }
    },
    "modelProviderRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "providerKind": {
          "enum": ["openai-compatible"]
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "taskTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "capabilityRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/namespacedId"
          },
          "uniqueItems": true,
          "default": []
        },
        "assignedAgentId": {
          "$ref": "#/definitions/namespacedId"
        },
        "assignedAgentVersion": {
          "$ref": "#/definitions/semver"
        },
        "inputs": true,
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true,
          "default": []
        },
        "retryPolicy": {
          "$ref": "#/definitions/retryPolicy"
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "backoff", "retryableFailurePhases", "idempotency", "externalWriteRetry"],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "backoff": {
          "enum": ["none", "fixed", "linear", "exponential"]
        },
        "retryableFailurePhases": {
          "type": "array",
          "items": {
            "enum": ["runtime-start", "execution", "provider", "verification", "artifact-export", "connector-rate-limit"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "idempotency": {
          "enum": ["read-only", "idempotent", "non-idempotent"]
        },
        "externalWriteRetry": {
          "enum": ["forbid", "require-approval", "allow"]
        }
      }
    }
  }
}
