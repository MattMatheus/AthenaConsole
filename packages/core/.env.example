# ProjectAthena example configuration
# Copy to .env and adjust values for your local environment.

# Default model routing used by runtime/CLI when provider/model are omitted.
ATHENA_DEFAULT_PROVIDER=foundry
ATHENA_PROVIDER_FALLBACK_ORDER=openai
ATHENA_DEFAULT_MODEL=gpt-4o-mini

# Microsoft Foundry provider settings (primary path).
# Use `az login` for local Entra ID auth, then set endpoint + deployment.
# ATHENA_FOUNDRY_ENABLED=true
# ATHENA_FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com
# ATHENA_FOUNDRY_DEPLOYMENT=gpt-4o-mini
# ATHENA_FOUNDRY_API_VERSION=2024-05-01-preview
# ATHENA_FOUNDRY_USE_ENTRA_ID=true
# ATHENA_FOUNDRY_AUDIENCE=https://cognitiveservices.azure.com/.default
# ATHENA_FOUNDRY_MANAGED_IDENTITY_CLIENT_ID=<managed-identity-client-id>

# Optional explicit Foundry API key fallback when Entra ID is disabled/unavailable.
# ATHENA_FOUNDRY_API_KEY=your_foundry_key_here

# Optional local service principal creds for Foundry Entra ID auth from containers.
# AZURE_TENANT_ID=<tenant-id>
# AZURE_CLIENT_ID=<service-principal-client-id>
# AZURE_CLIENT_SECRET=<service-principal-client-secret>

# OpenAI-compatible provider settings (fallback/compatibility path).
# Required when ATHENA_DEFAULT_PROVIDER=openai or ATHENA_PROVIDER_FALLBACK_ORDER includes openai.
ATHENA_OPENAI_API_KEY=your_openai_key_here

# Optional override for OpenAI-compatible endpoints (Groq, Ollama proxy, etc.).
# Leave default for OpenAI's hosted API.
ATHENA_OPENAI_BASE_URL=https://api.openai.com/v1

# Azure managed identity / workload identity auth (opt-in).
# When enabled, OpenAI requests can use Entra ID tokens from DefaultAzureCredential.
# Local development still works with ATHENA_OPENAI_API_KEY or Azure CLI login.
# ATHENA_AZURE_AUTH_ENABLED=false
# ATHENA_AZURE_OPENAI_USE_ENTRA_ID=false
# ATHENA_AZURE_OPENAI_AUDIENCE=https://cognitiveservices.azure.com/.default
# ATHENA_AZURE_MANAGED_IDENTITY_CLIENT_ID=<managed-identity-client-id>
# ATHENA_AZURE_BILLING_ENABLED=false
# ATHENA_AZURE_BILLING_AUDIENCE=https://management.azure.com/.default
# Prefer explicit scope for Cost Management query permissions:
# ATHENA_AZURE_BILLING_SCOPE_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg-name>
# Or set subscription + optional resource group:
# ATHENA_AZURE_BILLING_SUBSCRIPTION_ID=<sub-id>
# ATHENA_AZURE_BILLING_RESOURCE_GROUP_NAME=<rg-name>
# ATHENA_AZURE_BILLING_API_VERSION=2023-03-01

# Optional Key Vault fallback for legacy OpenAI API key retrieval.
# Used only when ATHENA_OPENAI_API_KEY is unset.
# ATHENA_AZURE_KEY_VAULT_URL=https://<vault-name>.vault.azure.net
# ATHENA_AZURE_OPENAI_KEY_SECRET_NAME=athena-openai-api-key

# Local-first execution and lock defaults used when explicit provider overrides are omitted.
ATHENA_EXECUTION_PROVIDER_DEFAULT=docker
ATHENA_LOCK_PROVIDER_DEFAULT=local

# Distributed lock provider:
# - local: in-process lock map (default, single-node)
# - redis: shared lock backend for multi-node control planes
# - k8s-lease: Kubernetes coordination lease backend for multi-node clusters
# ATHENA_DISTRIBUTED_LOCK_PROVIDER=local

# Required when ATHENA_DISTRIBUTED_LOCK_PROVIDER=redis
# ATHENA_REDIS_URL=redis://localhost:6379/0

# Optional local sandbox backend provider.
# - local-placeholder: disables sandbox routing
# - docker: enables local Docker-backed sandbox lifecycle
# - k8s: enables Kubernetes pod-backed sandbox lifecycle
# ATHENA_SANDBOX_BACKEND_PROVIDER=docker
# ATHENA_SANDBOX_DOCKER_IMAGE=node:20-slim
# ATHENA_SANDBOX_DOCKER_USER=65532:65532
# ATHENA_SANDBOX_DOCKER_NETWORK_MODE=none
# Optional host path mounted into sandboxed engineer pods. Must be an absolute path.
# ATHENA_SANDBOX_WORKSPACE_HOST_PATH=/workspace
# Optional explicit repo mount used by docker-compose.local.yml.
# ATHENA_REPO_HOST_PATH=/absolute/path/to/source
# ATHENA_REPO_CONTAINER_PATH=/workspace/target-repo
# ATHENA_SANDBOX_K8S_IMAGE=node:20-slim
# ATHENA_SANDBOX_K8S_SERVICE_ACCOUNT=athena-sandbox
# ATHENA_SANDBOX_K8S_POD_PREFIX=athena-sbx

# Optional Kubernetes namespace override when ATHENA_DISTRIBUTED_LOCK_PROVIDER=k8s-lease.
# If unset, Athena resolves namespace from service account / kube context.
# ATHENA_K8S_NAMESPACE=athena-system

# API identity extraction and RBAC role mapping (trusted-header mode).
# When enabled, requests must include ATHENA_AUTH_IDENTITY_HEADER.
ATHENA_AUTH_ENABLED=false
# ATHENA_AUTH_IDENTITY_HEADER=x-athena-identity
# ATHENA_AUTH_DEFAULT_ROLE=Viewer
# ATHENA_AUTH_IDENTITY_ROLE_MAP=alice:Admin,bob:Operator,*:Viewer

# Event ledger retention controls.
# ATHENA_EVENT_RETENTION_DAYS=30
# ATHENA_EVENT_MAX_BYTES=5000000

# Optional Azure Application Insights integration.
# When enabled, control-plane emits distributed request/dependency telemetry and
# custom dimensions for runId/personaId/tenantId where available.
# ATHENA_APPINSIGHTS_ENABLED=false
# ATHENA_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
# ATHENA_APPINSIGHTS_SAMPLING_PERCENTAGE=20
# ATHENA_APPINSIGHTS_CLOUD_ROLE_NAME=athena-control-plane
# ATHENA_APPINSIGHTS_TRACK_DEPENDENCIES=true
